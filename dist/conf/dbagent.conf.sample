# DBAgent 부트스트랩 설정 샘플 (conf/dbagent.conf)
#
# 이 파일을 conf/dbagent.conf 로 복사해서 쓴다. 파일은 선택 사항이다 - 없으면 jar 안 번들 기본값으로 기동한다.
# jar 를 실행하는 작업 디렉터리 기준 ./conf/dbagent.conf 를 읽고, 이 파일의 값이 번들 기본값보다 우선한다.
# (명령행 --키=값 / -D 옵션 / 환경변수는 이 파일보다 더 우선한다.)
#
# 여기에는 "DB를 열기 전에 필요한 값"만 둔다. 이 값들은 DB 에 저장할 수 없다:
#  - 서버 포트, 내부 DB 파일 위치, 마스터 키 위치, 에러 사전 DB 위치
# 나머지 설정(타임아웃·임계치·갱신 주기 등)은 기존 application.properties 를 계속 쓰며, 이후 단계에서
# 시스템 설정 화면(DB 저장)으로 옮겨진다(설계문서/환경설정_DB화_설계_2026-10-04.md).
#
# 주의: 키 이름에 오타가 있어도 오류가 나지 않고 무시된다. 기동 로그에서
#       "부트스트랩 설정 파일 로드됨" 줄과 실제 적용된 포트를 확인할 것.
# 주의: 값은 줄 끝에 주석을 붙이지 말 것(# 뒤까지 값으로 읽힌다).
# 아래는 모두 기본값이다. 바꿀 항목만 주석(#)을 풀어서 쓴다.

# 웹 서버 포트. 번들 기본값은 8005.
#server.port=8700

# 내부 DB 파일 위치(로그인 계정/세션, 추이 시계열, 환경 설정). 번들 기본값은 db_config/ 하위.
# 이 폴더와 마스터 키 파일(dbagent.key)은 서버를 옮길 때 한 세트로 같이 옮겨야 한다.
#spring.datasource.url=jdbc:h2:file:./db_config/users
#dbagent.metrics.datasource.url=jdbc:h2:file:./db_config/metrics
#dbagent.dbconfig.datasource.url=jdbc:h2:file:./db_config/dbconfig;DEFRAG_ALWAYS=TRUE
# 성능 분석 DB 는 지정하지 않으면 metrics 와 같은 폴더에 perf 이름으로 만든다.
#dbagent.perf.datasource.url=

# 대상 DB 비밀번호 암호화 마스터 키 파일 경로. 비우면 작업 디렉터리의 dbagent.key 를 쓰고 없으면 자동 생성한다.
# 환경변수 DBAGENT_MASTER_KEY 가 있으면 그쪽이 우선한다. 키를 DB 에 두면 암호문과 열쇠가 한곳에 모이므로 파일/환경변수로만 지정한다.
#dbagent.security.key-file=

# AI DBA 에러 사전 DB 위치. 번들 기본값은 아래와 같다.
#aidba.errors-db-path=data/oracle_errors

# ── 내부 저장소 엔진 선택 (2026-10-13 추가, 기본 h2) ──
# 내부 저장소(로그인 계정·세션, 등록 DB·환경설정, 추이 지표, 성능 분석)를 H2 파일 대신 Oracle 19c 스키마 하나에 둘 때만 쓴다.
# 적지 않으면 h2 이고 지금까지와 똑같이 동작한다. oracle 로 바꾸면 위의 내부 DB 파일 위치 4개(spring.datasource.url 등)는 쓰지 않는다.
# 주의(2026-10-13 현재 구현 1단계): oracle 로 두면 접속(풀 4개)까지만 되고 테이블 생성·사용은 아직 되지 않아 기동이 멈춘다.
#       운영에서는 켜지 말 것 - 이후 단계가 끝나면 이 주의 문구를 지운다.
#dbagent.store.type=h2
# Oracle 접속 정보(dbagent.store.type=oracle 일 때 필수). 서비스명 방식 주소를 쓴다.
#dbagent.store.oracle.url=jdbc:oracle:thin:@//<host>:<port>/<서비스명>
#dbagent.store.oracle.username=
# 비밀번호. 지금은 평문만 된다(기동 로그에 경고가 남는다). ENC(...) 암호문은 다음 단계에서 지원한다.
# 평문일 때 주의: 역슬래시(\)는 두 번(\\) 적어야 하고, ${ 로 시작하는 글자는 다른 설정 참조로 해석되며, 줄 끝 공백도 값에 들어간다.
#dbagent.store.oracle.password=
# 접속 시도 제한 시간(ms, 기본 3000)과 응답 대기 제한 시간(ms, 기본 60000) - 저장소가 멈췄을 때 앱 스레드가 오래 붙잡히지 않게 한다.
#dbagent.store.oracle.connect-timeout-ms=3000
#dbagent.store.oracle.read-timeout-ms=60000
# 저장소별 풀 최대 크기(기본 users 5, dbconfig 5, metrics 4, perf 4 - 합계 최대 18세션). 최소 유휴 접속은 1개로 고정이다.
#dbagent.store.oracle.pool.users.max-size=5
#dbagent.store.oracle.pool.dbconfig.max-size=5
#dbagent.store.oracle.pool.metrics.max-size=4
#dbagent.store.oracle.pool.perf.max-size=4

# ── (선택) 환경설정 화면의 값을 파일로 고정하기 ──
# 위 항목 말고도, 환경설정 화면(DB 저장)에서 바꾸는 설정 키를 이 파일에 적으면 그 값으로 고정된다 - 이 파일의 값은 화면에서 저장한
# 값보다 우선하고, 화면에는 "고정"으로 표시되어 바꿀 수 없다. 보통은 화면에서 저장하는 편이 낫다(재시작 없이 적용·되돌리기 가능).
# 키 이름·기본값·설명은 application.properties.sample 과 환경설정 화면을 본다. 파일을 바꾸면 재시작해야 적용된다.
#
# 수집 시 SQL 텍스트 미리 저장(2026-10-13, 기본 0=꺼짐, 범위 0~50, 권장 시작값 20): 1분 SQL 통계 수집 때 텍스트가 아직 없는 SQL을
# Elapsed 큰 순으로 사이클당 이 개수까지 대상 DB에서 SQL_ID 단건 조회로 읽어 저장한다. 꺼 두면 화면을 열 때만 읽어, 그 전에 공유 풀에서
# 밀려난 SQL은 SQL 분석 화면에 SQL_ID만 보인다. SYS 내부 SQL은 일반 SQL을 저장하고 남는 자리에만 저장한다.
# 대상 DB 조회는 사이클당 이 값의 5배까지, 한 사이클에 최대 1초까지만 쓴다.
#dbagent.monitor.sqlstat-text-capture-max-per-cycle=0
