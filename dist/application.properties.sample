# ═══════════════════════════════════════════════════════════════════════════
# [2026-10-04 환경설정 DB화] 이 파일의 역할이 바뀌었다 (설계문서/환경설정_DB화_설계_2026-10-04.md)
#
#  - 아래 설정 대부분(타임아웃·임계치·보존 기간·갱신 주기·AI/튜닝 주소·SQL 실행 제한·접속/풀 설정 등 62개)은 이제
#    톱니 메뉴 > "시스템 설정" 화면에서 바꾸고 DB 에 저장한다. 저장하면 재시작 없이 바로 적용된다.
#  - 이 파일은 "옛 설정"으로 남는다. 새 jar 를 처음 기동할 때 이 파일에서 기본값과 다른 값만 DB 로 1회 옮겨 가며(이관),
#    그 뒤로는 DB 값이 이 파일보다 우선한다 -> 이관 후에 이 파일을 고쳐도 반영되지 않는다(기동 로그에 불일치 경고).
#    값을 바꾸려면 시스템 설정 화면을 쓸 것.
#  - 이 파일을 없애도 앱은 뜬다(번들 기본값 사용). 정리 절차는 가이드/폐쇄망_적용절차_2026-10-04_배포11.md 5절.
#  - 기동 전에 필요한 값(웹 포트, 내부 DB 파일 위치, 마스터 키 위치, 에러 사전 위치)은 DB 에 둘 수 없어서
#    별도 파일 conf/dbagent.conf 에 둔다(conf/dbagent.conf.sample 참고). 이 값들은 이 파일에 써도 읽히지만,
#    conf/dbagent.conf 가 있으면 그쪽이 우선한다.
#  - 재시작이 필요한 키는 점검 수집 주기·일 점검 시각 2개뿐이다(시스템 설정 화면에서 바꿔도 "재시작 대기"로 표시되고 재시작해야 적용).
#    접속/응답 대기 시간과 커넥션 풀 크기는 저장하면 풀을 다시 만들어 바로 적용된다(위험 표시, 변경 사유 필수).
#  - 비상: DB 에 저장한 값 때문에 문제가 생기면 DB 값을 무시하는 안전 모드로 기동할 수 있다
#    (환경변수 DBAGENT_SETTINGS_IGNORE_DB=true 또는 java -Ddbagent.settings.ignore-db=true).
# ═══════════════════════════════════════════════════════════════════════════

# ============================================================================
#  DBAgent-Java 외부 설정 샘플  (DBAgent-Java-AIX \ dist  — 개발기(Windows) 로컬 실행용)
# ============================================================================
#
#  [사용법]
#    이 파일을 같은 폴더에 application.properties 라는 이름으로 복사한 뒤,
#    필요한 줄만 앞의 '#' 을 지워서 사용한다.
#      cp application.properties.sample application.properties
#
#    .sample 확장자인 동안에는 Spring Boot 가 읽지 않으므로 그냥 둬도 무해하다.
#    (Spring Boot 가 찾는 파일명은 application.properties / application.yml 뿐)
#
#  [중요 - 전부 적을 필요 없다]
#    jar 옆의 이 파일은 jar 안에 번들된 설정을 '대체'하지 않고 '덮어쓰기'만 한다.
#    여기 없는 키는 jar 안 BOOT-INF/classes/application.properties 값이 그대로 쓰인다.
#    따라서 이 환경에서 값이 달라야 하는 것만 골라 적으면 되고, 일부만 적어도
#    앱이 기동하지 못하는 일은 없다.
#
#  [반영 방법]
#    이 파일은 jar 밖에 있으므로 재빌드가 필요 없다. 값을 고친 뒤 앱만 재기동하면 된다.
#
#  아래 값은 전부 '현재 기본값'이다. 그대로 두면 지금과 동일하게 동작한다.
# ============================================================================


# ── 서버 ─────────────────────────────────────────────────────────────────
# HTTP 포트.
#server.port=8700

# ── 대상 DB 비밀번호 암호화 마스터 키 ───────────────────────────────────
# 등록된 대상 DB 접속 비밀번호는 AES-GCM으로 암호화되어 저장된다(6단계, 2026-09-21).
# 비워두거나 이 줄이 없으면 앱 작업 디렉터리의 dbagent.key를 쓰고, 그 파일이 없으면 최초 기동 시
# 자동 생성한다 - 운영자가 미리 준비할 것은 없다. 환경변수 DBAGENT_MASTER_KEY가 있으면 우선한다.
# 이 JVM이 AES-256을 허용하지 않으면(IBM J9의 무제한 정책 파일 미설치) 자동으로 128비트 키를
# 만들고 WARN을 남긴다 - 폐쇄망에서 정책 파일 때문에 기동이 막히지 않게 하기 위함이다.
#
# 운영 환경에서는 아래처럼 앱 폴더 밖(백업 스크립트가 훑지 않는 곳)을 지정하는 것을 권장하고,
# 퍼미션 600으로 두고(앱이 POSIX 환경에서 자동 설정) 별도 장소에 사본 1부를 보관할 것.
# 키를 잃으면 기존 암호문은 복구 불가 - 관리 화면에서 각 인스턴스 비밀번호를 다시 입력해야 한다.
# 키는 환경마다 독립이다: dbconfig.mv.db만 다른 서버로 복사하면 복호화되지 않는다(의도된 동작).
#dbagent.security.key-file=/home/dbagent/.dbagent/dbagent.key

# ── 계정 DB / 로그인 세션 ────────────────────────────────────────────────
# H2 파일 DB(순수 Java - sqlite-jdbc 의 플랫폼별 네이티브 라이브러리가 필요 없어 AIX 에서 동작).
# 실제 파일명은 users.mv.db 가 된다. 기본값은 db_config/ 하위(2026-09-21부터 - 앱 폴더 바로 밑에
# DB 파일을 두지 않고 한 곳에 모아 관리하기 위함. 디렉터리는 미리 있어야 한다).
#spring.datasource.url=jdbc:h2:file:./db_config/users
#spring.datasource.driver-class-name=org.h2.Driver
#spring.datasource.username=sa
#spring.datasource.password=
# sessionForToken()이 모든 인증 요청마다 호출되는 고빈도 읽기 경로라 dbconfig.mv.db와 동일하게
# 10으로 통일한다(2026-09-21 - 과거 "쓰기 양이 적어 1로 둔다" 메모는 낡은 것, H2 MVStore는 동시
# 읽기에 강해 풀을 키워도 안전하다).
#spring.datasource.hikari.maximum-pool-size=10
# LOCK_TIMEOUT(ms): dbconfig.mv.db와 동일 취지의 안전마진.
#spring.datasource.hikari.connection-init-sql=SET LOCK_TIMEOUT 5000
# 로그인 세션 만료 기간(일). 로그아웃을 안 눌러도 이 기간이 지나면 토큰이 자동 만료되고,
# 매일 새벽 3시 정리 작업이 해당 행을 실제로 삭제한다.
#dbagent.auth.session-ttl-days=30

# ── 메트릭 이력 저장소 위치 ────────────────────────────────────────────────
# instance_metric_history(metrics.mv.db)도 users.mv.db와 함께 db_config/ 하위에 둔다. v2 대시보드의
# fetchMetricHistoryV2()가 폴링마다 이 풀에서 읽기 커넥션을 빌려가므로 풀 크기도 동일하게 10.
#dbagent.metrics.datasource.url=jdbc:h2:file:./db_config/metrics
#dbagent.metrics.datasource.hikari.maximum-pool-size=10
#dbagent.metrics.datasource.hikari.connection-init-sql=SET LOCK_TIMEOUT 5000
#dbagent.metrics.datasource.driver-class-name=org.h2.Driver
#dbagent.metrics.datasource.username=sa
#dbagent.metrics.datasource.password=
# 성능 분석 저장소(perf)의 위치와 풀 크기. url을 지정하지 않으면 metrics와 같은 폴더에 파일 이름만 perf로 바꿔 만든다.
# 드라이버·계정·접속 초기화 SQL은 metrics 설정을 그대로 따른다.
#dbagent.perf.datasource.url=
#dbagent.perf.datasource.hikari.maximum-pool-size=4

# ── DB 목록 저장소(db_instances, 구 databases.json) ──────────────────────
# 등록된 DB 목록(관리 화면 db-mgmt.html)을 담는 전용 H2(dbconfig.mv.db), 마찬가지로 db_config/ 하위.
#dbagent.dbconfig.datasource.url=jdbc:h2:file:./db_config/dbconfig
# resolve()가 거의 모든 API 요청 진입부에서 호출되는 고빈도 읽기 경로인 데다, v2 대시보드는 폴링
# 한 번에 API 6개를 동시에 쏘아 그 6개가 전부 이 풀에서 동시에 커넥션을 빌려간다 - 기본값 3은 그
# 시점에 바로 바닥나서 "환경설정 DB 리스트가 가끔 느리다" 증상으로 이어질 수 있다(오케스트레이터
# 실측, 2026-09-21, main에서 먼저 확인 후 동일 반영). 등록된 DB 개수(테이블 행 수) 자체는 인덱스
# 단건 조회라 거의 영향이 없고, 동시 열람 탭/사용자 수가 실제 병목이다. users/metrics와 풀 크기
# 10으로 통일(2026-09-21).
#dbagent.dbconfig.datasource.hikari.maximum-pool-size=10
# LOCK_TIMEOUT(ms): main(SQLite)의 busy_timeout에 해당하는 H2 설정 - 락을 못 얻으면 즉시 예외를
# 던지는 대신 이 시간만큼 기다렸다가 재시도한다. 풀을 키운 만큼 커밋 순간과 겹칠 확률도 같이
# 올라가므로 안전마진으로 둔다.
#dbagent.dbconfig.datasource.hikari.connection-init-sql=SET LOCK_TIMEOUT 5000
#dbagent.dbconfig.datasource.driver-class-name=org.h2.Driver
#dbagent.dbconfig.datasource.username=sa
#dbagent.dbconfig.datasource.password=

# ── Oracle 대상 설정 ─────────────────────────────────────────────────────
# 새 Oracle 커넥션을 수립하는 최대 시간(ms). 망 지연이 크면 올린다(작으면 정상 DB를 down 으로 오판).
#dbagent.oracle.connect-timeout-ms=3000
# 이미 연결된 커넥션에서 쿼리 응답을 기다리는 최대 시간(ms, oracle.net.READ_TIMEOUT).
# 위 connect-timeout 과 목적이 다르다. 짧게 잡으면 AWR/ASH 조회나 SQL 튜닝처럼 원래 오래 걸리는
# 쿼리가 "DB 접속 불가"로 오인되어 죽는다.
#dbagent.oracle.read-timeout-ms=60000
# HikariCP 풀 크기 기본값. databases.json 인스턴스가 pool_min_idle/pool_max_size 를 지정하면 그쪽이 우선.
#dbagent.oracle.pool.min-idle=2
#dbagent.oracle.pool.max-size=10
# v$lock 스캔(Current Session 세션 리스트의 TX/TM Lock 집계, Lock Holder/Waiter Tree) 쿼리 타임아웃(초).
# 일부 인스턴스는 enqueue 해시체인이 길어 v$lock 스캔 자체가 수십 초까지 걸릴 수 있어 짧게 캡을 건다.
#dbagent.monitor.lock-query-timeout-seconds=3
# 화면 조회 공통 쿼리 타임아웃(초) - Current Session 세션 리스트·서브탭(Active Transaction 등), 테이블 스페이스,
# Table 관계·테이블 정보, 세션 상세 SQL/실행계획. 넘으면 이번 조회만 실패(빈 목록/오류)하고 다음 폴링에서 다시 시도한다(2026-10-01).
#dbagent.monitor.screen-query-timeout-seconds=10
# Current Session 서브탭(Active Transaction 등) 조회 실패가 이어질 때 같은 DB·탭·사유의 경고 로그를 다시 남기는 간격(분).
# 처음 실패·사유 변경·복구는 바로 남기고, "조회 권한 없음"은 한 번만 남긴다. 0이면 이어지는 실패는 다시 남기지 않는다(2026-10-01).
#dbagent.monitor.session-extra-fail-log-minutes=10
# TM Lock 장애 판정 기준(초). last_call_et 가 이 시간 이상이면서, 자기는 막혀 있지 않고 다른 세션을
# 막고 있는 TM Lock Holder 만 장애 판정(장애조치 버튼)과 "Blocking Session 감지" 알림에 센다.
# 값이 없거나 잘못된 값이면 60 으로 동작한다.
#dbagent.monitor.tm-holder-last-call-et-seconds=60
# /api/health(대시보드 상단 인스턴스/리스너 Alive 표시)의 Busy 세이프티넷. waiting>0 휴리스틱이
# 폴링 동시성으로 self-inflicted pool contention과 진짜 DB 다운을 오판할 수 있어, Busy가 이 시간
# 이상 끊기지 않고 지속되면 강제로 Not Alive 로 확정한다(2026-09-28).
#dbagent.monitor.health-busy-max-seconds=30

# ASH 구간 조회(성능 분석·대시보드 Top 등)에서 ASH 인메모리 보관 범위를 벗어난 구간을
# dba_hist_active_sess_history(AWR, 10초 간격)로 보충할지. Diagnostics Pack이 없는 사이트는 false (2026-09-25)
#dbagent.monitor.ash-awr-fallback=true
# AWR이 섞인 구간 조회의 타임아웃(초) - ASH만 쓰는 조회는 ash-activity-query-timeout-seconds
#dbagent.monitor.ash-awr-query-timeout-seconds=60
# ASH만 쓰는 구간 조회(ASH 활동 차트 등)의 타임아웃(초).
#dbagent.monitor.ash-activity-query-timeout-seconds=10

# 대시보드 개편 수집 테이블(mon_*) 보관 기간(일) - 1분/10분/일 테이블, KILL 감사 로그 (2026-09-25)
#dbagent.monitor.store-retention-days=30
#dbagent.monitor.kill-audit-retention-days=365
# 추이 차트용 지표(instance_metric_history) 보관 기간(일).
#dbagent.monitor.metric-retention-days=15
# 성능 분석 수집 이력(ASH 분 집계, SQL 텍스트 등 perf 저장소) 보관 기간(일).
#dbagent.monitor.perf-retention-days=15
# 추이 지표·SQL 통계(v$sqlstats 델타) 샘플러의 수집 주기(초). 샘플러, "최근 N초" 계산, SQL 통계 델타 수집이 서로 맞물려 있어
# 환경설정 화면에는 나오지 않는다. 스케줄러 주기라 바꾸면 재시작해야 적용된다. 짧게 하면 대상 DB 조회가 그만큼 늘어난다.
#dbagent.monitor.metric-sample-interval-seconds=60

# 새 대시보드 (2026-09-26) - 모두 선택, 없으면 아래 기본값
# ③ Lock: 장애 판정 Holder 수, KILL 대상 좁히기(기본은 USER Holder 전체), TX를 row lock만 셀지
#dbagent.monitor.tm-holder-incident-count=6
#dbagent.monitor.tm-holder-kill-blocking-only=false
#dbagent.monitor.tm-holder-kill-inactive-only=false
#dbagent.monitor.lock-tx-row-lock-only=false
#dbagent.monitor.lock-cache-millis=2000
# ③ Lock 표시 색 기준(환경설정 화면에서 DB별로도 지정 가능). 주의 값은 위험 값보다 작아야 한다.
# Holder 수가 이 개수 이상이면 주의 색(장애 판정 개수 tm-holder-incident-count보다 작아야 한다, 0=주의 단계 없음).
#dbagent.monitor.tm-holder-warn-count=3
# 행 Lock(TX) 대기 세션 수: 주의 / 위험
#dbagent.monitor.lock-tx-wait-warn=5
#dbagent.monitor.lock-tx-wait-crit=10
# 테이블 Lock(TM) 대기 세션 수: 주의 / 위험
#dbagent.monitor.lock-tm-wait-warn=3
#dbagent.monitor.lock-tm-wait-crit=6
# ③ Lock 실시간 차트 A안(2026-09-28): 마지막으로 본 뒤 N분 동안은 화면이 없어도 3초마다 계속 수집(0=끔, B안만).
# 켜면 그 시간 동안 원본 DB에 3초마다 Lock 조회가 나간다 - 운영 DB에서 조회 1회 부하를 실측한 뒤 정할 것.
#dbagent.monitor.lock-keepalive-minutes=0
# 동시에 백그라운드 수집하는 DB 수 상한(넘으면 가장 오래 전에 본 DB부터 제외, 0=상한 없음)
#dbagent.monitor.lock-keepalive-max-dbs=5
# 성능 분석 개편 Phase 1a(2026-10-09): Lock 분석용 락 대기 이력 수집. 기존 60초 ASH 수집의 같은 구간에서 락 이벤트 4종(TX row lock·
# ITL·index contention, TM)의 행만 더 읽는다(새 원본 조회 종류 없음, 쿼리 제한 시간은 lock-query-timeout-seconds). 끄려면 false.
#dbagent.perf.lock-collect-enabled=true
# 같은 블로커·같은 락 유형의 대기 샘플이 이 초보다 오래 끊기면 별개의 락 발생 건으로 나눈다(ASH 샘플은 약 1초 간격).
#dbagent.perf.lock-gap-sec=30
# 성능 분석 Phase 1b(2026-10-09): Lock 분석 블로커 상세 수집(기본 꺼짐). 켜면 락 대기자가 있을 때만 v$session(블로커 SID 목록, 바인드)·
# v$lock(TM 건의 블로커만, type='TM')·v$sqlstats(블로커 SQL 앞부분)·FK 인덱스 판정(dba_constraints·dba_ind_columns, 테이블 단위 하루 캐시)을
# 추가로 조회해 TX_UNCOMMITTED·TM_DDL·TM_LOCK_TABLE·TM_FK_NOINDEX까지 판정한다. 모두 lock-query-timeout-seconds 제한. 켜기 전에 DB 부하를 확인할 것.
#dbagent.perf.blocker-detail-enabled=false
# 블로커 상세 수집이 켜진 경우 TM 건 블로커의 TM 보유 모드를 v$lock 으로 따로 조회할지(기본 true). 락 발생 때 v$lock 이 느리면 false.
#dbagent.perf.blocker-tm-mode-enabled=true
# 성능 분석 "시스템 부하" 수집(2026-10-09, 기본 꺼짐): 60초 샘플러가 v$sysmetric(60초 그룹 지표 9개)·v$eventmetric(Idle 제외, 대기 시간 상위 50개(분당 100µs 미만 제외))을 1분마다 읽는다.
# PDB 서비스로 등록한 DB는 두 뷰가 비어 있어 수집하지 않는다(화면에 판단 보류). 켜기 전에 DB 부하를 확인할 것.
#dbagent.perf.sys-collect-enabled=false
# 시스템 부하 진단 기준(%, ms): 지표 카드 강조 / 대기 평균 악화 배수(200=2배) / Hard parse 증가(현재 초당 1건 이상일 때만 힌트) / db file sequential read 지연
#dbagent.perf.diag-card-pct=30
#dbagent.perf.diag-wait-ratio-pct=200
#dbagent.perf.diag-hard-parse-pct=100
#dbagent.perf.diag-seq-read-ms=10
# 성능 분석 "오브젝트·I/O" 수집(2026-10-11, 기본 꺼짐): 수집 주기마다 v$segstat(통계 5종 델타, 통계별 상위 50개만 저장)·v$filemetric(데이터파일 I/O)·v$tempstat·v$log_history(최근 24시간 시간별 스위치)·
# v$tempseg_usage(SQL별 Temp 사용)를 읽는다. 모든 조회에 쿼리 제한 시간이 있고 실패한 항목은 건너뛴다(0으로 저장하지 않고 나머지는 저장). 주기당 조회 6건(+이름 확인 dba_objects 가끔 최대 4건).
# 대용량 DB에서는 v$segstat 한 번 읽기가 가장 무겁고, 세그먼트 행이 40만 개를 넘으면 그 DB의 세그먼트 수집을 6시간 쉰다. 켜기 전에 DB 부하를 확인할 것.
# 앱 재시작·수집 껐다 켬·대상 DB 인스턴스 재시작 뒤 첫 주기는 델타 기준값만 기억하고 저장하지 않는다. 세그먼트는 dataobj# 기준이라 클러스터 테이블은 구성 테이블 중 하나의 이름으로 보일 수 있다.
# CDB 루트로 등록한 DB는 루트 컨테이너의 오브젝트·파일만 읽는다(PDB 접속 권장). 보관은 perf-retention-days를 따른다.
# (2026-10-12) 데이터파일 I/O는 v$filemetric(DB가 10분마다 계산해 두는 최근 구간 값)을 읽고, 쓸 수 없는 DB(PDB 접속 등)만 v$filestat 누적값을 읽는다
# (폐쇄망 실측, 데이터파일 3,721개: v$filestat+이름 조인 6.24초 → v$filemetric 0.04초). 수집 주기를 10분보다 길게 잡으면 그 사이 구간은 건너뛴다.
# 이 값은 전체 기본값이고, 시스템 설정 화면에서 DB마다 따로 켜고 끌 수 있다.
#dbagent.perf.obj-collect-enabled=false
# 오브젝트·I/O 수집 주기(분, 스케줄러 주기라 재시작 후 적용). 짧을수록 세부 변화를 보지만 대상 DB 조회와 저장 행이 늘어난다.
#dbagent.perf.obj-collect-interval-min=10
# Redo 로그 스위치 기준선(회/시간): 이 횟수를 넘으면 차트 막대를 다른 색으로 표시하고 로그 그룹 크기 조정 힌트를 보여 준다.
#dbagent.perf.redo-switch-warn-per-hour=4
# 시스템 부하 대기 이벤트 분 데이터 보관 일수(기본 15). 지난주 비교에는 최소 8일 필요. 지표는 perf-retention-days를 따른다.
#dbagent.perf.sys-event-retention-days=15
# 성능 분석 "SQL 분석"(2026-10-09): 기존 1분 v$sqlstats 델타 수집(SqlStatDeltaCollector)을 확장한다(새 원본 조회 없음).
# 처음 보는 커서(주로 리터럴 SQL)의 누적값을 사이클당 max-rows개까지 SQL 단위로 저장(0=저장 안 함), 누적 실행 수가 max-execs 이하일 때만 인정.
#dbagent.monitor.sqlstat-new-cursor-max-rows=100
#dbagent.monitor.sqlstat-new-cursor-max-execs=1000
# 처음 보인 커서의 누적 Elapsed(초) 상한 - 오래 쉬다 돌아온 배치의 누적값이 한 분에 다시 더해지는 것을 막는다.
#dbagent.monitor.sqlstat-new-cursor-max-elapsed-sec=120
# 수집 시 SQL 텍스트 미리 저장(2026-10-13, 기본 0=꺼짐): 1분 수집 때 텍스트가 아직 없는 SQL을 Elapsed 큰 순으로 사이클당 이 개수까지
# 대상 DB에서 SQL_ID 단건 조회로 읽어 저장한다. 꺼 두면 화면을 열 때만 읽어, 그 전에 공유 풀에서 밀려난 SQL은 SQL_ID만 보인다.
# 이미 저장한 SQL은 다시 묻지 않고 한 사이클에 최대 1초까지만 쓴다. 범위 0~50, 권장 시작값 20.
# SYS가 파싱한 내부 SQL은 일반 SQL을 저장하고 남는 자리에만 저장한다(계정은 v$sql에서 읽음). 대상 DB 조회는 사이클당 이 값의 5배까지.
#dbagent.monitor.sqlstat-text-capture-max-per-cycle=0
# 1분 델타(mon_sqlstat_delta) 보관 일수 - store-retention-days와 이 값 중 작은 쪽까지만 보관(기본 7). 6시간 초과 구간은 시간 롤업을 쓴다.
#dbagent.perf.sqlstat-delta-retention-days=7
# 시간 롤업(perf_sql_hour): 시간마다 Elapsed 상위 N + 실행 수 상위 N(합집합) SQL, 보존 일수. 6시간 초과 조회·지난주 대비에 쓴다.
#dbagent.perf.rollup-top-n=200
#dbagent.perf.rollup-retention-days=90
# SQL 진단 배지 기준: 급증(지난주 대비 %, 최소 실행 수) / N+1 의심(초당 실행) / 커서 재사용 X(Parse 비율 %, 초당 실행) / 리터럴(SQL_ID 수)
#dbagent.perf.diag-sql-surge-pct=100
#dbagent.perf.diag-sql-surge-min-execs=10000
#dbagent.perf.diag-sql-nplus1-exec-sec=50
#dbagent.perf.diag-sql-reuse-parse-pct=90
#dbagent.perf.diag-sql-reuse-exec-sec=10
#dbagent.perf.diag-sql-literal-id-count=50
# ⑧ 점검 알림 "장시간 실행 쿼리" 실시간 카드(2026-09-30): ACTIVE 사용자 세션의 현재 호출이 이 초 이상이면 표시(0=끔).
# Idle 이벤트로 대기 중인 세션(AQ 리스너·sleep 등 늘 ACTIVE인 대기형)은 세지 않는다.
# 10분 점검이 아니라 3초 Lock 조회에 함께 센다(추가 조회는 해당 세션이 있을 때 상위 5개 목록, DB별 15초에 1회)
#dbagent.monitor.long-running-query-seconds=300
# ⑧ 점검 알림: 가벼운 항목 주기(분), 잡 실패 주기(분), 무거운 항목 실행 시각(시, 0~23 - 앱 기동 직후에도 1회)
#dbagent.monitor.check-interval-minutes=10
#dbagent.monitor.check-job-interval-minutes=30
#dbagent.monitor.check-daily-hour=3
# 임계치
#dbagent.monitor.check-tablespace-warn-pct=97
#dbagent.monitor.check-tablespace-crit-pct=98
#dbagent.monitor.check-fra-warn-pct=80
#dbagent.monitor.check-fra-crit-pct=90
#dbagent.monitor.check-temp-warn-pct=75
#dbagent.monitor.check-temp-crit-pct=90
#dbagent.monitor.check-exclude-owners=SYS,SYSTEM,AUDSYS,XDB,MDSYS,CTXSYS
# 스케줄러 잡 실패 점검 이름 패턴(쉼표 구분, % = 아무 글자, 대소문자 무시, JOB_NAME 또는 OWNER.JOB_NAME과 비교)
#  job-fail-downgrade: 주의/위험 대신 '확인' 등급으로 표시(기본 ORA$AT_% = Oracle 자동 유지보수 작업, 실행마다 이름 번호가 바뀜)
#  job-fail-exclude  : 점검에서 아예 제외(기본 없음)
#dbagent.monitor.job-fail-downgrade=ORA$AT_%
#dbagent.monitor.job-fail-exclude=
# 점검 쿼리 타임아웃(초). 1일 항목은 dbagent.oracle.read-timeout-ms보다 5초 짧게 자동 제한되므로, 더 길게 필요하면 두 값을 같이 올린다
#dbagent.monitor.check-query-timeout-seconds=30
#dbagent.monitor.check-daily-query-timeout-seconds=120
#dbagent.monitor.check-segment-snapshot-min-gb=1
# SQL 통계 델타 수집 타임아웃(초)
#dbagent.monitor.sqlstat-query-timeout-seconds=15
# Fleet Overview 의 인스턴스별 상태 점검 상한(초). connect-timeout 이 못 잡는 경우(DNS 지연 등)까지
# 포함해, 느린 인스턴스 하나가 화면 전체를 붙잡지 못하게 한다.
#dbagent.fleet-status.timeout-seconds=5
# 활성 알림(상단 알림 배지) 집계 조회 타임아웃(초). 넘으면 이번 조회만 건너뛰고 다음 폴링에서 다시 시도한다.
#dbagent.monitor.active-alerts-timeout-seconds=5

# ── RDB(MySQL / MariaDB / PostgreSQL / MS SQL Server / CUBRID) 커넥션 풀 ──
# Oracle 풀과 완전히 분리된 별도 설정이라 위 dbagent.oracle.* 의 영향을 받지 않는다.
#dbagent.rdb.connect-timeout-ms=2000
# 응답 없는 서버 하나가 커넥션을 영구 점유하는 것을 막는다. 풀 크기 기본값이 5라,
# 이런 hang 이 5번 나면 DB 가 복구돼도 그 인스턴스의 풀이 영구 고갈된다.
#dbagent.rdb.read-timeout-ms=60000
#dbagent.rdb.pool.min-idle=1
#dbagent.rdb.pool.max-size=5

# ── 화면 자동 갱신 주기 ──────────────────────────────────────────────────
# 대시보드 갱신 주기(ms). 1000 은 너무 촘촘해서 풀이 고갈되고 정상 DB 가 down 으로 보였다. 2000~5000 권장.
#dbagent.ui.polling-interval-ms=2000
# Current Session 메뉴 "리프레쉬 주기(초)" 입력칸의 기본값(세션 목록 갱신 주기, 1~60). 화면에서 바꿀 수 있고,
# 위쪽 두 그래프는 이 값과 무관하게 따로 갱신된다. 값이 없거나 잘못되면 3초.
#dbagent.ui.session-refresh-seconds=3
# AAS 차트(신규 대시보드)의 CPU 기준선·판정(CPU 초과 시간·부하율·진단 문구)을 논리 CPU(NUM_CPUS, 기본) 대신 물리 코어(NUM_CPU_CORES)로 볼지(2026-10-11).
# 켜면 물리 코어가 기준선, 논리 CPU가 보조선이 된다. 물리 코어 값을 못 읽은 DB는 켜도 논리 CPU 기준. CPU 사용률(%)의 분모와 다른 화면은 바뀌지 않는다. 화면은 저장 후 최대 약 1분 안에 반영된다.
#dbagent.ui.aas-cpu-physical=false
# Fleet Overview 갱신 주기(ms). 탭이 실제로 보일 때만 동작한다(Page Visibility API).
#dbagent.fleet-overview.polling-interval-ms=3000

# ── AI DBA (에러 검색 + LLM 생성, sqlrestapi 경유) ───────────────────────
# 에러 사전 H2 DB 의 파일 base 경로(확장자 없이 적는다 - 실제 파일은 data/oracle_errors.mv.db).
#aidba.errors-db-path=data/oracle_errors
# GPU 서버 방화벽이 REST API 포트(9300, sqlrestapi)만 열어주는 구성으로 확정되면서(2026-09-11)
# Ollama(11434)에는 AIX에서 더 이상 직접 못 붙는다 - 이 값은 이제 Ollama가 아니라 sqlrestapi(RAGController
# 의 /api/chat)의 베이스 URL이다. AI 챗봇/AI Current SQL 분석/AI SQL 작성기와 AI SQL 성능분석(SQL Tune
# Advisor)이 이 프로퍼티 하나를 공유한다(과거 aidba.ollama.url + sqltuneadvisor.api.url 두 프로퍼티를
# 통합, 2026-09-14). 스킴(http(s)://) 없이 IP:포트만 적어도 자동으로 http://가 붙는다. 어떤 LLM을
# 쓰는지는 이 URL이 가리키는 sqlrestapi 쪽 설정을 따르므로 여기서 모델명을 지정할 필요는 없다(과거
# aidba.ollama.model 프로퍼티는 제거됨). 사내망에서 접근 가능한 GPU 서버 주소로 바꿔서 사용할 것
# (기본값 localhost라 빠뜨리면 조용히 실패한다).
#aidba.restapi.url=http://<GPU서버>:9300
# 생성 응답 대기 한도(ms). 원격 GPU 서버는 로컬보다 네트워크 왕복 + 모델 로딩 시간이 더 걸릴 수 있어
# 넉넉하게 잡는다. 모델 크기와 실행 위치에 따라 적정값이 크게 다르다.
#aidba.ollama.timeout-ms=30000

# ── SQL 정합성/튜닝 모델 서버 ────────────────────────────────────────────
# 튜닝 모델(자체 파인튜닝 Qwen2.5-Coder-7B QLoRA 어댑터)을 서빙하는 FastAPI 서버 주소.
# 순수 HTTP(JSON) 호출이라 위치는 무관하다 - AIX엔 이 모델 서버를 직접 못 올리므로, 사내망에서
# 접근 가능한 GPU 서버 주소로 바꿔서 사용할 것(예: http://192.168.x.x:8010).
# 기본값이 localhost 라, 이 호스트에 서버가 없으면 설정을 빠뜨렸을 때 조용히 실패한다.
#sqltuning.api.url=http://localhost:8010
# 응답 대기 한도(ms). 프롬프트 길이와 GPU 성능에 따라 편차가 크다.
#sqltuning.api.timeout-ms=180000

# ── SQL Tune Advisor (사내 튜닝 사례 RAG 검색 + LLM 분석) ────────────────
# sqltuning.*(자체 파인튜닝 sLLM)과는 별개의 서버/연동이다 - 이쪽은 bge-m3 임베딩으로 사내 튜닝
# 사례를 OpenSearch에서 검색한 뒤 그 사례를 근거로 qwen3-coder:30b가 답변한다
# (sqltune-rag-java/RAGController 호출). 서버 주소는 위 aidba.restapi.url과 통합됨(2026-09-14) -
# 같은 GPU 서버의 같은 sqlrestapi라 별도 프로퍼티를 둘 이유가 없었다.
# 응답 대기 한도(ms)만 화면 성격이 달라 별도 유지. GPU 서버 성능과 검색된 사내 사례 분량에 따라
# 편차가 커서 sqltuning.* 과 동일하게 설정으로 뺐다.
#sqltuneadvisor.api.timeout-ms=180000

# ── SQL Runner (AI DBA 탭의 "SQL 실행") 상한 ─────────────────────────────
# max-rows 는 사용자가 건수를 지정하지 않았을 때의 기본값,
# max-rows-limit 은 사용자가 지정하더라도 넘을 수 없는 절대 상한선이다.
#dbagent.sql-runner.max-rows=500
#dbagent.sql-runner.max-rows-limit=5000
#dbagent.sql-runner.timeout-seconds=30
# SQL 실행 메뉴 읽기 전용 모드(기본 true): SELECT / WITH 조회문만 실행하고, 실행 중에는 읽기 전용 트랜잭션을 건다.
# DML(자동 커밋되어 되돌릴 수 없음)·DDL·PL/SQL이 필요할 때만 false로 끈다. "false"가 아닌 값은 켜진 것으로 본다.
#dbagent.sql-runner.read-only=true
